IDD_VERIFIER DIALOGEX 0, 0, 260, 206
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Application Verifier"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "",IDC_IMAGE,7,7,246,10
    LTEXT           "&Providers to load (VerifierDlls):",IDC_STATIC,7,22,246,8
    CONTROL         "",IDC_VRF_PROVIDERS,"SysListView32",LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,32,246,104
    LTEXT           "&Flags (VerifierFlags, hex):",IDC_STATIC,7,145,96,8
    EDITTEXT        IDC_VRF_FLAGS,106,143,60,14,ES_AUTOHSCROLL
    LTEXT           "Application Verifier (appverif.exe) keeps its tests' settings elsewhere; these are what Windows reads to load it.",IDC_STATIC,7,163,246,18
    DEFPUSHBUTTON   "OK",IDOK,149,185,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,203,185,50,14
END

