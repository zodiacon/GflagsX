STRINGTABLE
BEGIN
    IDR_MAINFRAME           "GFlagsX"
END

STRINGTABLE
BEGIN
    ID_FLAGS_APPLY          "Write the checked flags (and the image's settings)\nApply"
    ID_FLAGS_CLEARALL       "Uncheck all the flags\nClear All"
    ID_FLAGS_TOGGLE         "Check or uncheck the selected flags\nCheck / Uncheck"
    ID_IMAGE_NEW            "Add an executable to set flags and options for\nNew Image"
    ID_IMAGE_DELETE         "Delete the selected executable's settings\nDelete Image"
    ID_FLAGS_SPECIALPOOL    "Set the pool tag (or size) whose allocations go to special pool\nSpecial Pool"
    ID_FLAGS_OBJECTTRACE    "Trace the references to objects of pool tags or of an image's processes\nObject Reference Tracing"
    ID_EDIT_FIND            "Show the images whose names have the text typed\nFilter Images"
    ID_IMAGE_SILENTEXIT     "Set what happens when the selected executable's processes exit\nSilent Process Exit"
    ID_IMAGE_PAGEHEAP       "Set the selected executable's page heap options\nPage Heap"
    ID_IMAGE_VERIFIER       "Set the Application Verifier providers and flags of the selected executable\nApplication Verifier"
    ID_OPTIONS_DARKMODE     "Switch between dark and light mode\nDark Mode"
    ID_VIEW_REGISTRY        "The system's flags in the registry, for the next boot\nRegistry"
    ID_VIEW_KERNEL          "The running system's flags, until the next boot\nKernel"
    ID_VIEW_IMAGE           "The executables' flags and options\nImage"
    ID_VIEW_REFRESH         "Read the flags again, discarding changes\nReload"
    ID_EDIT_COPY            "Copy the selection\nCopy"
END

STRINGTABLE
BEGIN
    ID_APP_ABOUT            "Display program information, version number and copyright\nAbout"
    ID_APP_EXIT             "Quit the application\nExit"
END

STRINGTABLE
BEGIN
    ATL_IDS_IDLEMESSAGE     "Ready"
END

