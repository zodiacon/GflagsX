    "S",            ID_FLAGS_APPLY,         VIRTKEY, CONTROL, NOINVERT
    "N",            ID_IMAGE_NEW,           VIRTKEY, CONTROL, NOINVERT
    "1",            ID_VIEW_REGISTRY,       VIRTKEY, CONTROL, NOINVERT
    "2",            ID_VIEW_KERNEL,         VIRTKEY, CONTROL, NOINVERT
    "3",            ID_VIEW_IMAGE,          VIRTKEY, CONTROL, NOINVERT
    VK_F5,          ID_VIEW_REFRESH,        VIRTKEY, NOINVERT
END


