    CONTROL         "",IDC_PH_OPTION_FIRST+4,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,88,246,10
    CONTROL         "",IDC_PH_OPTION_FIRST+5,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,101,246,10
    CONTROL         "Only si&zes (bytes) from",IDC_PH_SIZE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,119,92,10
    EDITTEXT        IDC_PH_SIZE_START,102,117,60,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "to",IDC_PH_SIZE_LABEL,167,119,10,8
    EDITTEXT        IDC_PH_SIZE_END,180,117,60,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "&Random, percent of the allocations:",IDC_PH_RANDOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,137,140,10
    EDITTEXT        IDC_PH_RANDOM_VALUE,150,135,40,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Only in these &DLLs:",IDC_PH_DLLS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,155,92,10
    EDITTEXT        IDC_PH_DLLS_VALUE,102,153,151,14,ES_AUTOHSCROLL
    CONTROL         "Fault &injection",IDC_PH_FAULTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,173,92,10
    LTEXT           "Probability (in 10000s):",IDC_PH_FAULT_LABEL,24,189,90,8
    EDITTEXT        IDC_PH_FAULT_PROB,118,187,44,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Starting after (seconds):",IDC_PH_FAULT_LABEL2,24,207,90,8
    EDITTEXT        IDC_PH_FAULT_TIMEOUT,118,205,44,14,ES_AUTOHSCROLL | ES_NUMBER
